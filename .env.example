VITE_TMDB_API_READ_ACCESS_TOKEN="YOUR_TMDB_API_READ_ACCESS_TOKEN"

# TMDB API Key (v3) - Alternative
VITE_TMDB_API_KEY="YOUR_TMDB_API_KEY"
